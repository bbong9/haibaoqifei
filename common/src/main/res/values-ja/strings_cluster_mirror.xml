<resources>
    <string name="settings_cluster_mirror_main">センター画面をメーターに表示（実験的機能）</string>
    <string name="settings_cluster_mirror_main_summary">メーターにセンター画面と同じ CarPlay 映像を表示し、高德ナビの追従画面と車線も確認できます。センター画面の内容がそのまま表示され、動画デコーダーを追加で一つ使用します。60 fps を維持するため、有効時のセンター画面の解像度は最大 75% です。再接続後に適用されます。</string>
    <string name="settings_cluster_mirror_size">同期映像のサイズ</string>
    <string name="settings_cluster_mirror_size_safe">安全領域に収める</string>
    <string name="settings_cluster_mirror_size_full">メーターの高さに合わせる</string>
    <string name="settings_resolution_capped_by_cluster_mirror">メーター同期が有効です。60 fps を維持するため、実際の解像度は最大 75% です。</string>
    <string name="settings_cluster_mirror_nav_only">ナビゲーション中のみ表示</string>
    <string name="settings_cluster_mirror_nav_only_summary">ナビを使用していないときは車両本来の表示に戻し、デコードを停止して負荷を減らします。</string>
    <string name="settings_cluster_mirror_dock_crop">Dock を切り取る</string>
    <string name="settings_cluster_mirror_dock_crop_summary">中央画面の端にある CarPlay のアイコンバーを取り除きます。</string>
    <string name="settings_cluster_mirror_size_custom">カスタム</string>
    <string name="settings_cluster_mirror_custom_x">横位置</string>
    <string name="settings_cluster_mirror_custom_y">縦位置</string>
    <string name="settings_cluster_mirror_custom_w">幅</string>
    <string name="settings_cluster_mirror_custom_h">高さ</string>
    <string name="settings_cluster_music_seconds">表示時間</string>
    <string name="settings_cluster_music_seconds_summary">曲が変わった後のカードの表示時間。常時表示では曲名の表示時間になります。</string>
    <string name="settings_cluster_music_seconds_value">%1$d秒</string>
    <string name="settings_cluster_mirror_view_zoom">拡大</string>
    <string name="settings_cluster_mirror_view_focus_x">表示範囲の左右</string>
    <string name="settings_cluster_mirror_view_focus_x_summary">0 = センター画面の左端、100 = 右端。</string>
    <string name="settings_cluster_mirror_view_focus_y">表示範囲の上下</string>
    <string name="settings_cluster_mirror_view_focus_y_summary">0 = 上端、100 = 下端。</string>
    <string name="settings_cluster_mirror_turn_card">同期中に案内カードを表示</string>
    <string name="settings_cluster_mirror_turn_card_summary">センター画面の地図をメーターに表示する際、曲がる方向と距離を重ねて表示します。表示範囲を調整してAmapの案内部分を切り取れます。</string>
</resources>
