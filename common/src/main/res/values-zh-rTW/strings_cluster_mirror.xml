<resources>
    <string name="settings_cluster_mirror_main">儀表與中控螢幕同步（實驗性）</string>
    <string name="settings_cluster_mirror_main_summary">儀表顯示與中控螢幕相同的 CarPlay 畫面，使用高德導航時可看到跟車畫面和車道。中控顯示什麼，儀表就顯示什麼。會額外使用一個影片解碼器。為維持 60 幀，開啟後中控解析度最高為 75%，重新連線後生效。</string>
    <string name="settings_cluster_mirror_size">同步畫面大小</string>
    <string name="settings_cluster_mirror_size_safe">放在安全區內</string>
    <string name="settings_cluster_mirror_size_full">填滿儀表高度</string>
    <string name="settings_resolution_capped_by_cluster_mirror">儀表同步已開啟：為維持 60 幀，實際解析度最高為 75%。</string>
    <string name="settings_cluster_mirror_nav_only">只在導航時顯示</string>
    <string name="settings_cluster_mirror_nav_only_summary">未導航時恢復原車儀表顯示，並停止解碼以節省效能。</string>
    <string name="settings_cluster_mirror_dock_crop">裁掉 Dock</string>
    <string name="settings_cluster_mirror_dock_crop_summary">移除中控螢幕畫面邊緣的 CarPlay 圖示列。</string>
    <string name="settings_cluster_mirror_size_custom">自訂</string>
    <string name="settings_cluster_mirror_custom_x">水平位置</string>
    <string name="settings_cluster_mirror_custom_y">垂直位置</string>
    <string name="settings_cluster_mirror_custom_w">寬度</string>
    <string name="settings_cluster_mirror_custom_h">高度</string>
    <string name="settings_cluster_music_seconds">顯示時間</string>
    <string name="settings_cluster_music_seconds_summary">換歌後卡片顯示多久；選擇常駐時為歌名停留的時間。</string>
    <string name="settings_cluster_music_seconds_value">%1$d秒</string>
    <string name="settings_cluster_mirror_view_zoom">放大</string>
    <string name="settings_cluster_mirror_view_focus_x">取景左右</string>
